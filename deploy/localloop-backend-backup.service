[Unit]
Description=localLOOP Backend Backup
After=docker.service network.target
Requires=docker.service

[Service]
Type=oneshot
# /opt/localloop-backend is a placeholder: deploy/setup.sh rewrites every
# occurrence in this file to INSTALL_DIR (the checkout docker-compose.yml runs
# from) when installing the unit, so all three units agree on one path.
WorkingDirectory=/opt/localloop-backend
EnvironmentFile=-/opt/localloop-backend/.env
# ProtectSystem=strict requires ReadWritePaths targets to exist before ExecStart.
ExecStartPre=/bin/mkdir -p /opt/localloop-backend/backups
ExecStart=/opt/localloop-backend/deploy/backup.sh
User=root
Group=root
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectHome=yes masks /home entirely for the executed process -- this
# broke localloop-backend-healthcheck.service even with a matching
# ReadWritePaths=/ReadOnlyPaths= exception (status=203/EXEC), tested live
# 2026-08-14. Left off here for the same reason rather than repeat that
# failure; ProtectSystem=strict + NoNewPrivileges=yes still apply.
PrivateTmp=yes
ReadWritePaths=/opt/localloop-backend/backups /opt/localloop-backend/data
