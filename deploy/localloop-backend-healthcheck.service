[Unit]
Description=localLOOP Backend Health Check
After=docker.service network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/localloop-backend
EnvironmentFile=-/opt/localloop-backend/.env
ExecStart=/opt/localloop-backend/deploy/healthcheck-alert.sh
User=root
Group=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
