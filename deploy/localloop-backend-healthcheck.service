[Unit]
Description=localLOOP Backend Health Check
After=docker.service network.target

[Service]
Type=oneshot
# Path reflects this project's actual (only) deployment host -- verified
# 2026-08-14 that /opt/localloop-backend, used by the sibling backup
# service and the main-app service template, was never actually the real
# install path here (the live app runs via docker-compose from this exact
# directory; a separate, stale, crash-looping systemd unit was found
# pointed at /root/code/... instead). Edit both this path and the
# ReadOnlyPaths= line below together if this ever moves.
WorkingDirectory=/home/alphin/code/local-loop-io/localloop-backend
EnvironmentFile=-/home/alphin/code/local-loop-io/localloop-backend/.env
ExecStart=/home/alphin/code/local-loop-io/localloop-backend/deploy/healthcheck-alert.sh
User=root
Group=root
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectHome=yes masks /home entirely for the executed process -- tested
# live 2026-08-14: even with a matching ReadOnlyPaths= exception for the
# real deploy path (under /home/alphin), the unit still failed with
# status=203/EXEC. Left off rather than fighting the sandbox further;
# ProtectSystem=strict + NoNewPrivileges=yes still apply.
PrivateTmp=yes
