{
  "name": "@local-loop/localloop-backend",
  "version": "0.4.4",
  "private": true,
  "description": "Backend API for localLOOP expression-of-interest submissions",
  "author": "Mycel UG (haftungsbeschränkt) <dev@mycel-ai.de>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=25.1.0"
  },
  "volta": {
    "node": "25.1.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "migrate": "bun run src/db/migrate.ts",
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit",
    "import:sqlite": "bun run scripts/import-sqlite.ts",
    "seed:lab": "bun run scripts/seed-lab.ts",
    "cleanup:idempotency-keys": "bun run scripts/cleanup-idempotency-keys.ts",
    "simulate:lab": "bun run scripts/simulate-lab.ts",
    "lab:demo": "bun run scripts/lab-demo.ts",
    "simulate:federation": "bun run scripts/simulate-federation.ts",
    "lab:federation": "bun run scripts/lab-federation.ts",
    "prisma:generate": "prisma generate",
    "sync:schemas": "bun run scripts/sync-schemas.ts",
    "check:schemas": "bun run scripts/sync-schemas.ts --check",
    "check:conformance": "bun run scripts/check-conformance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.11",
    "bullmq": "^5.77.3",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "ajv": "8.18.0",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.11",
    "ajv": "8.18.0",
    "fast-xml-parser": "5.3.8",
    "hono": "4.12.5",
    "lodash": "4.17.23"
  }
}
