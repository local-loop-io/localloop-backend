# localLOOP Backend Environment Configuration
# Copy to .env and modify values as needed

# IMPORTANT: In production (NODE_ENV=production), you MUST set:
# - DATABASE_URL (with a secure password)
# - MINIO_SECRET_KEY (generate a strong secret)
# - BETTER_AUTH_SECRET (if AUTH_ENABLED=true)
# - API_KEY (if API_KEY_ENABLED=true)
# The application will refuse to start in production with default/missing secrets.

NODE_ENV=development
PORT=8088
PUBLIC_BASE_URL=https://loop-api.urbnia.com
NODE_ID=lab-hub.loop
NODE_NAME=localLOOP Lab Hub
# Canonical node-info enum values only (see .env.docker.example)
NODE_CAPABILITIES=material-registry,loopsignal
# Node location (required by canonical node-info schema; powers radius_km search)
NODE_LAT=48.1351
NODE_LON=11.582
NODE_CITY=Munich
NODE_COUNTRY=DE

# Postgres
# For development only - use strong passwords in production
POSTGRES_DB=localloop
POSTGRES_USER=localloop
POSTGRES_PASSWORD=localloop_dev_password
# Host-side URL: docker-compose.yml publishes Postgres on 127.0.0.1:55432.
# (Inside the compose network the api container uses .env.docker.example instead.)
DATABASE_URL=postgresql://localloop:localloop_dev_password@localhost:55432/localloop
DATABASE_SSL=false
DB_POOL_SIZE=10
# Connection pool timeouts (milliseconds)
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Server-level request timeout (milliseconds)
REQUEST_TIMEOUT_MS=30000

# Redis (Valkey in docker-compose.yml, published on 127.0.0.1:6381)
# The compose service always starts with --requirepass REDIS_PASSWORD, so the
# URL must embed the same password; production config also enforces this.
REDIS_PASSWORD=localloop_dev_redis
REDIS_URL=redis://:localloop_dev_redis@localhost:6381

# Object storage (SeaweedFS behind the storage-proxy nginx service, S3-compatible;
# the MINIO_* variable names are retained from the previous MinIO deployment).
# Host-side endpoint: docker-compose.yml publishes it on 127.0.0.1:9200.
# For development only - use strong passwords in production
MINIO_ENDPOINT=localhost
MINIO_PORT=9200
MINIO_ACCESS_KEY=localloop
MINIO_SECRET_KEY=localloop_dev_secret
MINIO_BUCKET=localloop-assets
MINIO_USE_SSL=false

# API settings
PUBLIC_LIMIT=100
ALLOWED_ORIGINS=https://localloop.urbnia.com
RATE_LIMIT_MAX=600
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_WINDOW=15 minutes
RATE_LIMIT_WRITE_WINDOW=15 minutes
SSE_KEEPALIVE_MS=25000
SSE_MAX_CLIENTS=200
BODY_LIMIT=1048576
RUN_MIGRATIONS=true
SEARCH_REFRESH_ON_WRITE=true

# Auth
# Generate a secure secret for production: openssl rand -hex 32
AUTH_ENABLED=false
AUTH_TRUSTED_ORIGINS=https://localloop.urbnia.com
BETTER_AUTH_SECRET=dev_auth_secret_not_for_production
API_KEY_ENABLED=false
API_KEY=dev_api_key_not_for_production

# Workers
WORKER_ENABLED=false

# Payments
PAYMENTS_ENABLED=false
